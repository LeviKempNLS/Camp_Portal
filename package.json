{
  "name": "faith-adventures-camp",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.6.2",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace=@faith-adventures/portal",
    "start": "npm run db:bootstrap && npm run start --workspace=@faith-adventures/portal",
    "build": "npm run prisma:generate && npm run build --workspace=@faith-adventures/portal",
    "lint": "npm run lint --workspace=@faith-adventures/portal",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run db:migrate:deploy && node --test --experimental-strip-types packages/database/src/integration.test.ts",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "playwright test",
    "prisma:generate": "npm run prisma:generate --workspace=@faith-adventures/database",
    "db:migrate:deploy": "npm run migrate:deploy --workspace=@faith-adventures/database",
    "db:migrate:dev": "npm run migrate:dev --workspace=@faith-adventures/database",
    "db:seed": "npm run seed --workspace=@faith-adventures/database",
    "demo:registrar": "npm run demo:registrar --workspace=@faith-adventures/auth",
    "db:bootstrap": "npm run db:migrate:deploy && npm run db:seed && npm run demo:registrar",
    "format:check": "prettier --check ."
  },
  "devDependencies": { "prettier": "^3.6.2" }
}
