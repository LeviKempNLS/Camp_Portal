{
  "name": "faith-adventures-camp",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.6.2",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace=@faith-adventures/portal",
    "build": "npm run build --workspace=@faith-adventures/portal",
    "lint": "npm run lint --workspace=@faith-adventures/portal",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace=@faith-adventures/domain",
    "format:check": "prettier --check ."
  },
  "devDependencies": { "prettier": "^3.6.2" }
}
