{
  "name": "@faith-adventures/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./portal": "./src/portal.ts",
    "./invitations": "./src/invitations.ts",
    "./admin": "./src/admin.ts",
    "./registration-operations": "./src/registration-operations.ts",
    "./operations": "./src/operations.ts",
    "./roster": "./src/roster.ts",
    "./finance": "./src/finance.ts",
    "./attendance": "./src/attendance.ts",
    "./medical": "./src/medical.ts",
    "./reports": "./src/reports.ts",
    "./communications": "./src/communications.ts",
    "./environment-safety": "./src/environment-safety.ts"
  },
  "scripts": {
    "prisma:generate": "DATABASE_URL=${DATABASE_URL:-postgresql://placeholder:placeholder@localhost:5432/placeholder} prisma generate --schema prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "seed": "node --experimental-strip-types prisma/seed.ts",
    "test": "node --test --experimental-strip-types src/index.test.ts src/environment-safety.test.ts src/deployment-configuration.test.ts src/initialization-configuration.test.ts",
    "typecheck": "tsc --noEmit",
    "migrate:status": "prisma migrate status --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2"
  },
  "devDependencies": {
    "prisma": "^6.16.2",
    "typescript": "^5.9.3"
  }
}
